{
  "manifest_version": 3,
  "name": "Lecture-Hunter 강의 위젯",
  "description": "강의 영상 위에 실시간 자막·질문·요약 위젯을 띄웁니다. 로컬 백엔드(127.0.0.1:8000)와 위젯 서버(127.0.0.1:9998)가 켜져 있어야 합니다.",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lecture-Hunter 켜기 / 끄기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["frame.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:* http://localhost:*"
  }
}
